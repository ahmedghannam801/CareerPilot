# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# LinkedIn OAuth 2.0 Credentials (Sign In with LinkedIn)
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"

# RapidAPI / JSearch for real-time jobs & opportunities
RAPIDAPI_KEY="your_rapidapi_key"
JSEARCH_RAPIDAPI_KEY="your_rapidapi_key"

# Supabase Cloud Backend (PostgreSQL)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: comma-separated Gemini models, first is preferred (defaults to gemini-3.5-flash, gemini-flash-latest, gemini-flash-lite-latest)
# GEMINI_MODELS="gemini-3.5-flash,gemini-flash-latest"

# Backend deploy: CORS_ORIGIN = your Cloudflare Pages URL.
# Frontend (set in Cloudflare Pages BEFORE the build): VITE_API_URL = your backend URL, e.g. https://careerpilot-api.onrender.com
# CORS_ORIGIN="https://careerpilot.pages.dev"
# VITE_API_URL="https://careerpilot-api.onrender.com"
